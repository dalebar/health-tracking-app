# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Set to false in production

# API Authentication (leave empty for local dev - auth bypassed)
# In production (Render), this is auto-generated
API_KEY=

# CORS Origins (comma-separated, * for all)
CORS_ORIGINS=*

# Environment
ENVIRONMENT=development  # development, staging, production

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# MCP Server & Dashboard Configuration
# For local dev, use localhost. For production, use deployed API URL.
HEALTH_API_URL=http://localhost:8000
HEALTH_API_KEY=  # Same as API_KEY when connecting to deployed API
