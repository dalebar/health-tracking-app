<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service label (must be unique) -->
    <key>Label</key>
    <string>com.daleb.health-import-watcher</string>

    <!-- Program to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/daleb/Documents/projects/health-tracking-app/.venv/bin/python3</string>
        <string>/Users/daleb/Documents/projects/health-tracking-app/src/watcher/watch_health_exports.py</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/daleb/Documents/projects/health-tracking-app</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/daleb/Documents/projects/health-tracking-app</string>
        <key>PATH</key>
        <string>/Users/daleb/Documents/projects/health-tracking-app/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Auto-start on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep alive (restart if crashes) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Restart throttle (wait 10s before restart) -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Standard output/error logs -->
    <key>StandardOutPath</key>
    <string>/Users/daleb/Documents/projects/health-tracking-app/logs/watcher_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daleb/Documents/projects/health-tracking-app/logs/watcher_stderr.log</string>

    <!-- Nice value (lower priority) -->
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
